# Copy to .env (local) and add the same values in Vercel → Project → Settings → Environment Variables.
# Never commit the real .env.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=saikrishnahomes

# Local only, if you get "querySrv ECONNREFUSED": use public DNS to find the Atlas cluster
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Long random secret for admin login sessions (64+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Website addresses allowed to call this API (comma separated)
ALLOWED_ORIGINS=https://sai-krishna-homes-web.vercel.app,http://localhost:5174

# New-enquiry email alerts (optional; leave empty to skip). For Gmail use an App Password:
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_TO=

# Local only
API_PORT=8787

# Phone / desktop notifications (Web Push). Make a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
