{
  "info": {
    "name": "Sai Krishna Homes API",
    "description": "All backend routes. 1) Start the backend (cd backend, npm run dev). 2) Run \"Login\" first: Postman keeps the session cookie for localhost automatically, so the admin requests work after it. 3) Run the folders top to bottom.\n\nbaseUrl defaults to http://localhost:8787. Set email/password collection variables to your admin login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8787"
    },
    {
      "key": "email",
      "value": "rohitprasad.sahoo@fidelsya.com"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "leadId",
      "value": ""
    },
    {
      "key": "enquiryId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Server is up."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
