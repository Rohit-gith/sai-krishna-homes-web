          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Session cookie set\", () => pm.expect(pm.cookies.has(\"skh_admin\")).to.be.true);"
                ]
              }
            }
          ]
        },
